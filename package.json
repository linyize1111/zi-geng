{
  "name": "zi-geng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "content:generate": "node scripts/content/convert-moe-idioms.mjs",
    "content:download-revised": "node scripts/content/download-moe-revised.mjs",
    "content:revised": "node scripts/content/convert-moe-revised.mjs",
    "content:writer": "node scripts/content/build-writer-vocab.mjs",
    "content:themed": "node scripts/content/build-themed-vocab.mjs",
    "content:themes": "node scripts/content/build-theme-series.mjs",
    "content:harvest": "node scripts/content/harvest-moe-themes.mjs",
    "content:craft": "node scripts/content/build-craft-cards.mjs",
    "content:import-craft": "node scripts/content/import-craft.mjs",
    "content:prompts": "node scripts/content/build-writing-prompts.mjs",
    "content:novel-plan": "node scripts/content/build-novel-plan-tasks.mjs",
    "content:import-prompts": "node scripts/content/import-prompts.mjs",
    "content:import-novel-tasks": "node scripts/content/import-novel-tasks.mjs",
    "content:archive-self-quotes": "node scripts/content/archive-self-quotes.mjs",
    "content:merge": "node scripts/content/merge-vocab-seeds.mjs",
    "content:build-all": "npm run content:writer && npm run content:themed && npm run content:craft && npm run content:download-idioms && SEED_LIMIT=400 npm run content:generate && npm run content:download-revised && npm run content:revised && npm run content:merge && npm run content:quotes && npm run content:prompts && npm run content:novel-plan",
    "content:fetch": "node scripts/content/fetch-wiktionary.mjs",
    "content:crawl": "node scripts/content/crawl-multi-source.mjs",
    "content:quotes": "node scripts/content/build-themed-quotes.mjs",
    "content:import": "node scripts/content/import-vocab.mjs",
    "content:import-quotes": "node scripts/content/import-quotes.mjs",
    "content:sync": "npm run content:fetch && npm run content:import -- scripts/content/fetched-wiktionary.json",
    "content:download-idioms": "node scripts/content/download-moe-idioms.mjs",
    "content:concised": "node scripts/content/convert-moe-concised.mjs",
    "content:bulk": "node scripts/content/bulk-enrich.mjs",
    "content:purge-low": "node scripts/content/purge-low-value-vocab.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
